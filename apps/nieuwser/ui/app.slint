import { Button, CheckBox, LineEdit, ListView, Palette, ScrollView } from "std-widgets.slint";

export struct FeedRow {
    id: string,
    title: string,
    folder: string,
    unread: int,
    icon: image,
}

export struct ArticleRow {
    id: string,
    title: string,
    feed: string,
    time: string,
    read: bool,
    starred: bool,
    selected: bool,
}

export struct ReaderBlock {
    kind: string,
    label: string,
    text: styled-text,
    chunks: [styled-text],
    indent: int,
    source: string,
    image: image,
    has-image: bool,
}

export global Theme {
    in property <bool> dark;
    out property <color> bg: dark ? #171715 : #f7f7f5;
    out property <color> surface: dark ? #1f1f1c : #ffffff;
    out property <color> surface-alt: dark ? #242420 : #fbfbf9;
    out property <color> block: dark ? #242420 : #f4f4f1;
    out property <color> text: dark ? #e8e8e2 : #242422;
    out property <color> text-muted: dark ? #a3a39a : #6b6b66;
    out property <color> text-faint: dark ? #7c7c74 : #999990;
    out property <color> border: dark ? #34342f : #e2e2de;
    out property <color> divider: dark ? #2b2b27 : #ecece8;
    out property <color> feed-selected: dark ? #2b3a4d : #e6edf7;
    out property <color> article-selected: dark ? #263141 : #eef3fa;
    out property <color> accent: dark ? #7ea6e0 : #4a6fa5;
    out property <color> settings-border: dark ? #3a3a34 : #d8d8d2;
    out property <color> danger: dark ? #e07a6f : #b03a2e;
    out property <color> warning: dark ? #d9b36a : #8a6d3b;
    out property <color> overlay: dark ? #00000099 : #00000066;
    out property <color> star: #c49a23;
}

component ReaderText inherits StyledText {
    in property <string> kind;
    default-font-size: kind == "h1" ? 26px
        : kind == "h2" ? 21px
        : kind == "h3" ? 18px
        : kind == "h4" || kind == "h5" || kind == "h6" ? 16px
        : kind == "code" ? 13px
        : kind == "table" ? 12px
        : kind == "image" ? 12px
        : 15px;
    default-color: kind == "quote" ? Theme.text-muted
        : kind == "image" ? Theme.text-muted
        : Theme.text;
    default-font-family: kind == "code" || kind == "table" ? "monospace" : "";
    horizontal-stretch: 1;
}

component Splitter inherits Rectangle {
    width: 7px;
    background: transparent;
    callback start(length);
    callback drag(length);
    callback finish();
    property <bool> dragging: false;

    Rectangle {
        x: (parent.width - 1px) / 2;
        width: 1px;
        height: parent.height;
        background: Theme.border;
    }

    TouchArea {
        mouse-cursor: col-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left) {
                if (event.kind == PointerEventKind.down) {
                    root.dragging = true;
                    root.start(self.absolute-position.x + self.pressed-x);
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    if (root.dragging) {
                        root.dragging = false;
                        root.finish();
                    }
                }
            }
        }
        moved => {
            if (root.dragging) {
                root.drag(self.absolute-position.x + self.mouse-x);
            }
        }
    }
}

component MenuButton inherits Rectangle {
    in property <string> text;
    callback activated();
    height: 30px;
    background: touch.has-hover ? Theme.article-selected : transparent;

    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.text;
        font-size: 13px;
        color: Theme.text;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

component ToolbarIconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: root.enabled && touch.has-hover ? Theme.block : transparent;
    opacity: root.enabled ? 1 : 0.4;

    Image {
        source: root.icon;
        width: 18px;
        height: 18px;
        image-fit: contain;
        colorize: Theme.text-muted;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.clicked(); }
    }
}

component ShortcutRow inherits Rectangle {
    in property <string> label;
    in property <string> key-text;
    in property <bool> capturing: false;
    callback edit();

    height: 32px;

    HorizontalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            horizontal-stretch: 1;
            vertical-alignment: center;
            font-size: 13px;
        }

        Rectangle {
            width: 130px;
            height: 28px;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.capturing ? Theme.accent : Theme.border;
            background: Theme.block;

            Text {
                text: root.capturing ? "Press a key…" : root.key-text;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-family: "monospace";
                font-size: 12px;
                color: Theme.text;
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: "Change shortcut for " + root.label;
                clicked => { root.edit(); }
            }
        }
    }
}

component SelectionContext inherits ContextMenuArea {
    in property <bool> has-selection;
    callback open-requested();
    callback copy-requested();
    callback set-read(bool);
    callback set-starred(bool);
    Menu {
        MenuItem { title: "Open in browser"; enabled: root.has-selection; activated => { root.open-requested(); } }
        MenuItem { title: "Copy link"; enabled: root.has-selection; activated => { root.copy-requested(); } }
        MenuSeparator {}
        MenuItem { title: "Mark as read"; enabled: root.has-selection; activated => { root.set-read(true); } }
        MenuItem { title: "Mark as unread"; enabled: root.has-selection; activated => { root.set-read(false); } }
        MenuSeparator {}
        MenuItem { title: "Add star"; enabled: root.has-selection; activated => { root.set-starred(true); } }
        MenuItem { title: "Remove star"; enabled: root.has-selection; activated => { root.set-starred(false); } }
    }
}

component ReaderSkeleton inherits Rectangle {
    background: Theme.surface;

    VerticalLayout {
        padding: 12px;
        spacing: 12px;

        Rectangle {
            width: parent.width * 0.58;
            height: 24px;
            border-radius: 4px;
            background: Theme.block;
        }
        Rectangle {
            width: parent.width * 0.32;
            height: 12px;
            border-radius: 3px;
            background: Theme.block;
        }
        Rectangle {
            width: parent.width;
            height: 1px;
            background: Theme.divider;
        }
        for index in 6 : Rectangle {
            width: parent.width * (index == 5 ? 0.54 : 0.92);
            height: 13px;
            border-radius: 3px;
            background: Theme.block;
        }
        Text {
            text: "Loading article…";
            color: Theme.text-faint;
            font-size: 12px;
        }
    }
}

component FeedSidebar inherits Rectangle {
    in property <[FeedRow]> feeds;
    in property <int> selected-index;
    in property <bool> interactive: true;
    callback select-feed(int);
    callback context-feed(int, length, length);
    callback context-empty(length, length);

    background: Theme.surface-alt;

    TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.interactive;
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.context-empty(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        Text {
            text: "Feeds";
            font-weight: 600;
            color: Theme.text-muted;
        }

        ListView {
            for feed[i] in root.feeds : Rectangle {
                height: 38px;
                border-radius: 6px;
                background: i == root.selected-index ? Theme.feed-selected : transparent;

                HorizontalLayout {
                    padding: 8px;
                    spacing: 6px;

                    Image {
                        source: feed.icon;
                        width: 16px;
                        height: 16px;
                        image-fit: contain;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: feed.title;
                            overflow: elide;
                            font-size: 13px;
                        }
                        Text {
                            text: feed.folder;
                            font-size: 10px;
                            color: Theme.text-faint;
                            overflow: elide;
                        }
                    }

                    Text {
                        text: feed.unread > 0 ? "(" + feed.unread + ")" : "";
                        width: 42px;
                        color: Theme.accent;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    enabled: root.interactive;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                            root.context-feed(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                    clicked => {
                        root.select-feed(i);
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Nieuwser";
    icon: @image-url("icons/nieuwser.svg");
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 560px;
    min-height: 480px;
    background: Theme.bg;

    in property <[FeedRow]> feeds;
    in property <[ArticleRow]> articles;
    in-out property <bool> has-more-articles: false;
    in-out property <bool> dark-mode: false;
    in-out property <length> feed-width: 260px;
    in-out property <length> list-width: 400px;
    private property <bool> compact: false;
    in-out property <string> compact-page: "list";
    in-out property <bool> feed-drawer-open: false;
    private property <int> space-presses: 0;
    property <length> drag-start-x;
    property <length> drag-start-width;
    property <length> max-feed-width: root.width - root.list-width - 340px < 160px ? 160px : root.width - root.list-width - 340px;
    property <length> max-list-width: root.width - root.feed-width - 340px < 240px ? 240px : root.width - root.feed-width - 340px;
    property <length> menu-x;
    property <length> menu-y;
    property <int> menu-kind: 0;
    property <bool> menu-open: false;

    public function open-menu(kind: int, pointer-x: length, pointer-y: length) {
        root.menu-kind = kind;
        root.menu-x = pointer-x > root.width - 220px ? root.width - 220px : pointer-x;
        root.menu-y = pointer-y > root.height - 230px ? root.height - 230px : pointer-y;
        root.menu-open = true;
    }

    init => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
        root.compact = root.width < 900px;
    }
    changed dark-mode => {
        Palette.color-scheme = self.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    in-out property <int> feed-index: 0;
    in-out property <int> article-index: -1;
    in property <string> reader-title;
    in property <string> reader-meta;
    in property <bool> reader-loading;
    in property <[ReaderBlock]> reader-blocks;
    in property <string> status;
    in property <string> last-synced;
    in property <bool> syncing: false;
    in-out property <bool> mark-read-on-open: true;
    in-out property <bool> mark-read-on-open-browser: true;
    in-out property <string> article-filter: "all";
    in-out property <length> article-content-y: 0px;
    in-out property <string> search-query;

    in-out property <bool> settings-open;
    in-out property <string> settings-url;
    in-out property <string> settings-email;
    in-out property <string> settings-password;
    in-out property <string> settings-status;
    in-out property <bool> settings-busy;
    in property <bool> settings-has-account;

    in-out property <string> shortcut-next: "j";
    in-out property <string> shortcut-prev: "k";
    in-out property <string> shortcut-read: "r";
    in-out property <string> shortcut-star: "f";
    in-out property <string> shortcut-open: "o";
    in-out property <string> shortcuts-status;
    private property <bool> shortcuts-open: false;
    private property <string> capturing-shortcut;
    private property <length> shortcuts-dialog-width: min(560px, root.width - 32px);
    private property <length> shortcuts-dialog-height: min(640px, root.height - 32px);

    callback refresh();
    callback open-settings();
    callback close-settings();
    callback save-settings(string, string, string);
    callback set-mark-read-on-open(bool);
    callback set-mark-read-on-open-browser(bool);
    callback set-dark-mode(bool);
    callback set-shortcut(string, string);
    callback reset-shortcuts();
    callback next-article();
    callback prev-article();
    callback select-feed(int);
    callback save-pane-widths(length, length);
    callback select-article(int, bool, bool);
    callback context-article(int);
    callback set-selection-read(bool);
    callback set-selection-starred(bool);
    callback open-selection();
    callback copy-selection-links();
    callback load-more();
    callback search(string);
    callback set-article-filter(string);
    callback return-to-list();
    callback open-link(string);
    callback toggle-read();
    callback toggle-star();
    callback mark-all-read();
    callback scroll-reader(length);

    forward-focus: main-focus;

    changed width => { root.compact = root.width < 900px; }
    changed compact => {
        if (!root.compact) {
            root.feed-drawer-open = false;
        }
    }
    changed article-index => { root.space-presses = 0; }
    changed compact-page => { root.space-presses = 0; }

    Timer {
        interval: 1s;
        running: root.space-presses > 0;
        triggered => { root.space-presses = 0; }
    }

    scroll-reader(delta) => {
        reader-scroll.content-y = Math.min(0px, Math.max(
            reader-scroll.content-y + delta,
            reader-scroll.visible-height - reader-scroll.content-height));
    }

    public function scroll-reader-to-top() {
        reader-scroll.content-y = 0px;
    }

    public function open-shortcuts() {
        root.settings-open = false;
        root.settings-password = "";
        root.settings-status = "";
        root.capturing-shortcut = "";
        root.shortcuts-status = "";
        root.shortcuts-open = true;
        shortcuts-help.focus();
    }

    public function close-shortcuts() {
        root.shortcuts-open = false;
        root.capturing-shortcut = "";
        root.shortcuts-status = "";
        main-focus.focus();
    }

    public function reveal-article(index: int) {
        let row-y = index * 64px;
        let top = 0px - article-list.content-y;
        if (row-y < top) {
            article-list.content-y = 0px - row-y;
        } else if (row-y + 64px > top + article-list.visible-height) {
            article-list.content-y = 0px - (row-y + 64px - article-list.visible-height);
        }
        article-list.content-y = Math.min(0px, Math.max(
            article-list.content-y,
            article-list.visible-height - article-list.content-height));
    }

    main-focus := FocusScope {
        width: root.width;
        height: root.height;

        key-pressed(event) => {
            if (event.text != " ") {
                root.space-presses = 0;
            }
            if (root.settings-open) {
                if (event.text == Key.Escape) {
                    root.close-settings();
                    accept
                } else {
                    reject
                }
            } else if (event.text == "?") {
                root.open-shortcuts();
                accept
            } else if (root.compact && root.feed-drawer-open && event.text == Key.Escape) {
                root.feed-drawer-open = false;
                accept
            } else if (root.compact && root.compact-page == "reader" && event.text == Key.Escape) {
                root.return-to-list();
                accept
            } else if (event.text == Key.PageDown) {
                root.scroll-reader(0px - reader-scroll.visible-height * 0.9);
                accept
            } else if (event.text == " " && !event.modifiers.shift) {
                if (root.compact && root.compact-page == "reader") {
                    root.space-presses += 1;
                    if (root.space-presses >= 3) {
                        root.space-presses = 0;
                        if (root.article-index + 1 < root.articles.length) {
                            root.next-article();
                        } else {
                            root.scroll-reader(0px - reader-scroll.visible-height * 0.9);
                        }
                    } else {
                        root.scroll-reader(0px - reader-scroll.visible-height * 0.9);
                    }
                    accept
                } else {
                    root.scroll-reader(0px - reader-scroll.visible-height * 0.9);
                    accept
                }
            } else if (event.text == Key.PageUp) {
                root.scroll-reader(reader-scroll.visible-height * 0.9);
                accept
            } else if (event.text == " " && event.modifiers.shift) {
                root.space-presses = 0;
                root.scroll-reader(reader-scroll.visible-height * 0.9);
                accept
            } else if (event.text == Key.Home) {
                reader-scroll.content-y = 0px;
                accept
            } else if (event.text == Key.End) {
                root.scroll-reader(0px - reader-scroll.content-height);
                accept
            } else if (event.text == Key.DownArrow) {
                root.scroll-reader(0px - 64px);
                accept
            } else if (event.text == Key.UpArrow) {
                root.scroll-reader(64px);
                accept
            } else if ((event.text == root.shortcut-open
                    && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta)
                || (event.text == "o" && event.modifiers.control
                    && !event.modifiers.alt && !event.modifiers.meta)) {
                root.open-selection();
                accept
            } else if (event.text == root.shortcut-next && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                root.next-article();
                accept
            } else if (event.text == root.shortcut-prev && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                root.prev-article();
                accept
            } else if (event.text == root.shortcut-read && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                root.toggle-read();
                accept
            } else if (event.text == root.shortcut-star && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                root.toggle-star();
                accept
            } else {
                reject
            }
        }

        Rectangle {
            width: parent.width;
            height: parent.height;

        VerticalLayout {
            width: parent.width;
            height: parent.height;
        Rectangle {
            height: 52px;
            background: Theme.surface;
            HorizontalLayout {
                padding: 12px;
                spacing: 12px;

                Image {
                    source: @image-url("icons/nieuwser.svg");
                    width: 28px;
                    height: 28px;
                    image-fit: contain;
                    vertical-alignment: center;
                }

                Text {
                    text: "Nieuwser";
                    font-size: 17px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                if !root.compact : Rectangle {
                    width: 1px;
                    background: Theme.border;
                }

                if !root.compact : Text {
                    text: root.status;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if !root.compact : Text {
                    text: root.syncing ? "Syncing…" : "";
                    color: Theme.warning;
                    vertical-alignment: center;
                }

                if !root.compact : Text {
                    text: root.last-synced;
                    color: Theme.text-faint;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                Button {
                    text: "Settings";
                    enabled: !root.syncing && !root.settings-open;
                    clicked => {
                        root.open-settings();
                    }
                }

                Button {
                    text: "Refresh";
                    enabled: !root.syncing && !root.settings-open;
                    clicked => {
                        root.refresh();
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        Rectangle {
            width: 100%;
            vertical-stretch: 1;

            FeedSidebar {
                visible: !root.compact;
                x: 0px;
                width: root.feed-width;
                height: parent.height;
                feeds: root.feeds;
                selected-index: root.feed-index;
                interactive: !root.settings-open;
                select-feed(index) => {
                    root.feed-index = index;
                    root.select-feed(index);
                    root.compact-page = "list";
                    root.feed-drawer-open = false;
                }
                context-feed(index, x, y) => {
                    root.feed-index = index;
                    root.select-feed(index);
                    root.open-menu(1, x, y);
                }
                context-empty(x, y) => { root.open-menu(1, x, y); }
            }

            Splitter {
                visible: !root.compact;
                x: root.feed-width;
                width: 7px;
                height: parent.height;
                start(x) => {
                    root.drag-start-x = x;
                    root.drag-start-width = root.feed-width;
                }
                drag(x) => {
                    root.feed-width = root.drag-start-width + x - root.drag-start-x;
                    if (root.feed-width < 160px) {
                        root.feed-width = 160px;
                    }
                    if (root.feed-width > root.max-feed-width) {
                        root.feed-width = root.max-feed-width;
                    }
                }
                finish => {
                    root.save-pane-widths(root.feed-width, root.list-width);
                }
            }

            Rectangle {
                visible: !root.compact || root.compact-page == "list";
                x: root.compact ? 0px : root.feed-width + 7px;
                width: root.compact ? parent.width : root.list-width;
                height: parent.height;
                background: Theme.surface;

                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    enabled: !root.settings-open;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                            root.open-menu(2, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }

                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 8px;
                        if root.compact : ToolbarIconButton {
                            icon: @image-url("icons/menu.svg");
                            label: "Feeds";
                            enabled: !root.settings-open;
                            clicked => { root.feed-drawer-open = true; }
                        }
                        Text {
                            text: "Articles";
                            font-weight: 600;
                            color: Theme.text-muted;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "Mark all read";
                            enabled: !root.settings-open;
                            clicked => {
                                root.mark-all-read();
                            }
                        }
                    }

                    LineEdit {
                        placeholder-text: "Search articles…";
                        enabled: !root.settings-open;
                        text <=> root.search-query;
                        edited => {
                            root.search(root.search-query);
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: "Show";
                            color: Theme.text-muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "All";
                            primary: root.article-filter == "all";
                            enabled: !root.settings-open;
                            clicked => { root.set-article-filter("all"); }
                        }
                        Button {
                            text: "Unread";
                            primary: root.article-filter == "unread";
                            enabled: !root.settings-open;
                            clicked => { root.set-article-filter("unread"); }
                        }
                        Button {
                            text: "Read";
                            primary: root.article-filter == "read";
                            enabled: !root.settings-open;
                            clicked => { root.set-article-filter("read"); }
                        }
                    }

                    if root.articles.length == 0 : Text {
                        text: "No articles match this view.";
                        color: Theme.text-faint;
                        horizontal-alignment: center;
                        font-size: 12px;
                    }

                    article-list := ListView {
                        content-y <=> root.article-content-y;
                        for article[i] in root.articles : Rectangle {
                            height: 64px;
                            border-radius: 6px;
                            background: article.selected ? Theme.article-selected : transparent;

                            HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;

                                Text {
                                    text: article.read ? "" : "●";
                                    width: 8px;
                                    horizontal-alignment: center;
                                    color: Theme.accent;
                                    font-size: 8px;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: article.title;
                                        font-size: 13px;
                                        font-weight: article.read ? 400 : 600;
                                        horizontal-alignment: left;
                                        overflow: elide;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: article.feed;
                                            color: Theme.text-muted;
                                            font-size: 11px;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: article.time;
                                            color: Theme.text-faint;
                                            font-size: 11px;
                                        }
                                        Text {
                                            text: article.starred ? "★" : "";
                                            color: Theme.star;
                                            font-size: 11px;
                                        }
                                    }
                                }
                            }

                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                enabled: !root.settings-open;
                                double-clicked => {
                                    root.open-selection();
                                }
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                        root.context-article(i);
                                        root.open-menu(2, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                    } else if (event.button == PointerEventButton.middle && event.kind == PointerEventKind.down) {
                                        root.select-article(i, false, false);
                                        root.open-selection();
                                    } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                        root.select-article(i, event.modifiers.control, event.modifiers.shift);
                                    }
                                }
                            }
                        }
                    }

                    if root.has-more-articles : Button {
                        text: "Load more";
                        enabled: !root.settings-open;
                        clicked => {
                            root.load-more();
                        }
                    }
                }
            }

            Splitter {
                visible: !root.compact;
                x: root.feed-width + root.list-width + 7px;
                width: 7px;
                height: parent.height;
                start(x) => {
                    root.drag-start-x = x;
                    root.drag-start-width = root.list-width;
                }
                drag(x) => {
                    root.list-width = root.drag-start-width + x - root.drag-start-x;
                    if (root.list-width < 240px) {
                        root.list-width = 240px;
                    }
                    if (root.list-width > root.max-list-width) {
                        root.list-width = root.max-list-width;
                    }
                }
                finish => {
                    root.save-pane-widths(root.feed-width, root.list-width);
                }
            }

            Rectangle {
                visible: !root.compact || root.compact-page == "reader";
                x: root.compact ? 0px : root.feed-width + root.list-width + 14px;
                width: root.compact ? parent.width : parent.width - root.feed-width - root.list-width - 14px;
                height: parent.height;
                background: Theme.surface;

                SelectionContext {
                    has-selection: root.article-index >= 0;
                    open-requested => { root.open-selection(); }
                    copy-requested => { root.copy-selection-links(); }
                    set-read(value) => { root.set-selection-read(value); }
                    set-starred(value) => { root.set-selection-starred(value); }

                SwipeGestureHandler {
                    enabled: root.compact;
                    width: parent.width;
                    height: parent.height;
                    handle-swipe-left: root.compact && root.article-index >= 0 && root.article-index + 1 < root.articles.length;
                    handle-swipe-right: root.compact && root.article-index > 0;
                    swiped => {
                        let dx = self.current-position.x - self.pressed-position.x;
                        if (dx < -80px) {
                            root.next-article();
                        } else if (dx > 80px) {
                            root.prev-article();
                        }
                    }

                VerticalLayout {
                    padding-top: 24px;
                    padding-bottom: 24px;
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 8px;
                        if root.compact : ToolbarIconButton {
                            icon: @image-url("icons/arrow-left.svg");
                            label: "Back to articles";
                            clicked => { root.return-to-list(); }
                        }
                        Text {
                            text: "Reader";
                            font-weight: 600;
                            color: Theme.text-muted;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        ToolbarIconButton {
                            icon: @image-url("icons/open-browser.svg");
                            label: "Open in browser";
                            enabled: !root.settings-open && root.article-index >= 0;
                            clicked => {
                                root.open-selection();
                            }
                        }
                        Button {
                            text: "Mark read";
                            enabled: !root.settings-open;
                            clicked => {
                                root.toggle-read();
                            }
                        }
                        Button {
                            text: "Star";
                            enabled: !root.settings-open;
                            clicked => {
                                root.toggle-star();
                            }
                        }
                    }

                    reader-frame := Rectangle {
                        clip: true;

                        reader-scroll := ListView {
                            for block in root.reader-blocks : VerticalLayout {
                                spacing: 4px;
                                padding-bottom: 8px;

                                if block.kind == "title" : Text {
                                    text: block.label;
                                    font-size: 24px;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                    width: reader-scroll.visible-width;
                                }

                                if block.kind == "meta" : Text {
                                    text: block.label;
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    width: reader-scroll.visible-width;
                                }

                                if block.kind == "empty" : Text {
                                    text: block.label;
                                    color: Theme.text-faint;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                    width: reader-scroll.visible-width;
                                }

                                if block.kind == "rule" : Rectangle {
                                    height: 1px;
                                    background: Theme.divider;
                                }

                                if block.kind == "image" : Rectangle {
                                    background: Theme.block;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;

                                        if block.has-image : Image {
                                            source: block.image;
                                            height: 320px;
                                            image-fit: contain;
                                        }

                                        Text {
                                            text: block.label;
                                            font-weight: 600;
                                            wrap: word-wrap;
                                        }
                                        if !block.has-image : ReaderText {
                                            text: block.text;
                                            kind: block.kind;
                                            width: reader-scroll.visible-width - 40px;
                                            link-clicked(link) => {
                                                root.open-link(link);
                                            }
                                        }
                                    }
                                }

                                if block.kind == "code" || block.kind == "table" : Rectangle {
                                    background: Theme.block;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 4px;
                                        if block.label != "" : Text {
                                            text: block.label;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.text-muted;
                                        }
                                        VerticalLayout {
                                            spacing: 0;
                                            horizontal-stretch: 1;
                                            for chunk in block.chunks : ReaderText {
                                                text: chunk;
                                                kind: block.kind;
                                                width: reader-scroll.visible-width - 40px;
                                            }
                                        }
                                    }
                                }

                                if block.kind != "rule" && block.kind != "image" && block.kind != "code"
                                    && block.kind != "table" && block.kind != "title"
                                    && block.kind != "meta" && block.kind != "empty" : HorizontalLayout {
                                    padding-left: block.indent * 18px;
                                    spacing: 8px;

                                    if block.kind == "quote" : Rectangle {
                                        width: 3px;
                                        background: Theme.border;
                                    }

                                    if block.label != "" : Text {
                                        text: block.label;
                                        width: 30px;
                                        color: Theme.text-muted;
                                        font-size: 14px;
                                        vertical-alignment: top;
                                    }

                                    VerticalLayout {
                                        spacing: 0;
                                        horizontal-stretch: 1;
                                        for chunk in block.chunks : ReaderText {
                                            text: chunk;
                                            kind: block.kind;
                                            // Slint 1.18 measures wrapped text at its unconstrained width.
                                            width: reader-scroll.visible-width - 20px - block.indent * 18px
                                                - (block.kind == "quote" ? 11px : 0px)
                                                - (block.label != "" ? 38px : 0px);
                                            link-clicked(link) => {
                                                root.open-link(link);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.reader-loading : ReaderSkeleton { }
                    }
                }
                }
            }
        }
        }
    }

    if root.compact && root.feed-drawer-open : Rectangle {
        y: 53px;
        width: root.width;
        height: root.height - 53px;
        background: #00000066;

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.feed-drawer-open = false; }
        }

        FeedSidebar {
            x: 0px;
            width: min(300px, max(0px, root.width - 48px));
            height: parent.height;
            feeds: root.feeds;
            selected-index: root.feed-index;
            interactive: !root.settings-open;
            select-feed(index) => {
                root.feed-index = index;
                root.select-feed(index);
                root.compact-page = "list";
                root.feed-drawer-open = false;
            }
            context-feed(index, x, y) => {
                root.feed-index = index;
                root.select-feed(index);
                root.open-menu(1, x, y);
            }
            context-empty(x, y) => { root.open-menu(1, x, y); }
        }
    }

    if root.menu-open : Rectangle {
        width: root.width;
        height: root.height;
        background: transparent;

        TouchArea {
            clicked => { root.menu-open = false; }
        }

        VerticalLayout {
            Rectangle { height: root.menu-y; }
            HorizontalLayout {
                Rectangle { width: root.menu-x; }
                Rectangle {
                    width: 210px;
                    height: root.menu-kind == 1 ? 72px : 210px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 6px;
                    clip: true;

                    MenuButton {
                        x: 4px; y: 4px; width: parent.width - 8px; height: 30px;
                        text: "Mark all as read";
                        visible: root.menu-kind == 1;
                        activated => {
                            root.menu-open = false;
                            root.mark-all-read();
                        }
                    }
                    MenuButton {
                        x: 4px; y: 36px; width: parent.width - 8px; height: 30px;
                        text: "Refresh";
                        visible: root.menu-kind == 1;
                        activated => {
                            root.menu-open = false;
                            root.refresh();
                        }
                    }
                    MenuButton {
                        x: 4px; y: 4px; width: parent.width - 8px; height: 30px;
                        text: "Open in browser";
                        visible: root.menu-kind == 2;
                        activated => {
                            root.menu-open = false;
                            root.open-selection();
                        }
                    }
                    MenuButton {
                        x: 4px; y: 36px; width: parent.width - 8px; height: 30px;
                        text: "Copy link";
                        visible: root.menu-kind == 2;
                        activated => {
                            root.menu-open = false;
                            root.copy-selection-links();
                        }
                    }
                    Rectangle { x: 4px; y: 68px; width: parent.width - 8px; height: 1px; background: Theme.border; visible: root.menu-kind == 2; }
                    MenuButton {
                        x: 4px; y: 71px; width: parent.width - 8px; height: 30px;
                        text: "Mark as read";
                        visible: root.menu-kind == 2;
                        activated => {
                            root.menu-open = false;
                            root.set-selection-read(true);
                        }
                    }
                    MenuButton {
                        x: 4px; y: 103px; width: parent.width - 8px; height: 30px;
                        text: "Mark as unread";
                        visible: root.menu-kind == 2;
                        activated => {
                            root.menu-open = false;
                            root.set-selection-read(false);
                        }
                    }
                    Rectangle { x: 4px; y: 135px; width: parent.width - 8px; height: 1px; background: Theme.border; visible: root.menu-kind == 2; }
                    MenuButton {
                        x: 4px; y: 138px; width: parent.width - 8px; height: 30px;
                        text: "Add star";
                        visible: root.menu-kind == 2;
                        activated => {
                            root.menu-open = false;
                            root.set-selection-starred(true);
                        }
                    }
                    MenuButton {
                        x: 4px; y: 170px; width: parent.width - 8px; height: 30px;
                        text: "Remove star";
                        visible: root.menu-kind == 2;
                        activated => {
                            root.menu-open = false;
                            root.set-selection-starred(false);
                        }
                    }
        
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }

        }


    }
    if root.settings-open : FocusScope {
        width: parent.width;
        height: parent.height;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-settings();
                accept
            } else {
                reject
            }
        }

        Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: Theme.overlay;

        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        Rectangle {
            width: 460px;
            height: 560px;
            x: (parent.width - 460px) / 2;
            y: (parent.height - 560px) / 2;
            background: Theme.surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.settings-border;

            VerticalLayout {
                padding: 24px;
                spacing: 8px;

                Text {
                    text: root.settings-has-account ? "FreshRSS account" : "Connect to FreshRSS";
                    font-size: 22px;
                    font-weight: 700;
                }

                Text {
                    text: "Enter your server URL and API password. The password is exchanged for a token and is not saved.";
                    color: Theme.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                CheckBox {
                    text: "Mark articles read when opened";
                    checked <=> root.mark-read-on-open;
                    toggled => {
                        root.set-mark-read-on-open(self.checked);
                    }
                }

                CheckBox {
                    text: "Mark articles read when opening in browser";
                    checked <=> root.mark-read-on-open-browser;
                    toggled => {
                        root.set-mark-read-on-open-browser(self.checked);
                    }
                }

                CheckBox {
                    text: "Dark theme";
                    checked <=> root.dark-mode;
                    toggled => {
                        root.set-dark-mode(self.checked);
                    }
                }

                Text {
                    text: "Server URL";
                    color: Theme.text-muted;
                    font-size: 12px;
                    font-weight: 600;
                }
                LineEdit {
                    text <=> root.settings-url;
                    placeholder-text: "https://freshrss.example.net/api/";
                }

                Text {
                    text: "Username or email";
                    color: Theme.text-muted;
                    font-size: 12px;
                    font-weight: 600;
                }
                LineEdit {
                    text <=> root.settings-email;
                    placeholder-text: "admin";
                }

                Text {
                    text: "API password";
                    color: Theme.text-muted;
                    font-size: 12px;
                    font-weight: 600;
                }
                LineEdit {
                    text <=> root.settings-password;
                    input-type: password;
                }

                Text {
                    text: root.settings-status;
                    color: Theme.danger;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Button {
                    text: "Keyboard shortcuts…";
                    enabled: !root.settings-busy;
                    clicked => { root.open-shortcuts(); }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    if root.settings-has-account : Button {
                        text: "Cancel";
                        enabled: !root.settings-busy;
                        clicked => {
                            root.close-settings();
                        }
                    }

                    Button {
                        text: root.settings-busy ? "Connecting…" : "Save & sync";
                        enabled: !root.settings-busy;
                        clicked => {
                            root.save-settings(root.settings-url, root.settings-email, root.settings-password);
                        }
                    }
                }
            }
        }
        }
    }

    shortcuts-help := FocusScope {
        visible: root.shortcuts-open;
        width: root.width;
        height: root.height;

        key-pressed(event) => {
            if (root.capturing-shortcut != "") {
                if (event.text == Key.Escape) {
                    root.capturing-shortcut = "";
                    accept
                } else if (event.text != "" && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                    root.set-shortcut(root.capturing-shortcut, event.text);
                    root.capturing-shortcut = "";
                    accept
                } else {
                    reject
                }
            } else if (event.text == Key.Escape || event.text == "?") {
                root.close-shortcuts();
                accept
            } else {
                reject
            }
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.overlay;

            TouchArea {
                width: parent.width;
                height: parent.height;
            }

            Rectangle {
                width: root.shortcuts-dialog-width;
                height: root.shortcuts-dialog-height;
                x: (parent.width - root.shortcuts-dialog-width) / 2;
                y: (parent.height - root.shortcuts-dialog-height) / 2;
                background: Theme.surface;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.settings-border;

                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;

                    Text {
                        text: "Keyboard shortcuts";
                        font-size: 22px;
                        font-weight: 700;
                    }

                    Text {
                        text: "Click a key field, then press the new key. Escape cancels.";
                        color: Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    shortcuts-scroll := ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            width: shortcuts-scroll.visible-width - 14px;
                            spacing: 6px;

                            Text {
                                text: "Change shortcuts";
                                color: Theme.text-muted;
                                font-size: 12px;
                                font-weight: 600;
                            }

                            ShortcutRow {
                                label: "Next article";
                                key-text: root.shortcut-next;
                                capturing: root.capturing-shortcut == "next";
                                edit => {
                                    root.capturing-shortcut = "next";
                                    root.shortcuts-status = "";
                                }
                            }
                            ShortcutRow {
                                label: "Previous article";
                                key-text: root.shortcut-prev;
                                capturing: root.capturing-shortcut == "prev";
                                edit => {
                                    root.capturing-shortcut = "prev";
                                    root.shortcuts-status = "";
                                }
                            }
                            ShortcutRow {
                                label: "Mark read / unread";
                                key-text: root.shortcut-read;
                                capturing: root.capturing-shortcut == "read";
                                edit => {
                                    root.capturing-shortcut = "read";
                                    root.shortcuts-status = "";
                                }
                            }
                            ShortcutRow {
                                label: "Star / unstar";
                                key-text: root.shortcut-star;
                                capturing: root.capturing-shortcut == "star";
                                edit => {
                                    root.capturing-shortcut = "star";
                                    root.shortcuts-status = "";
                                }
                            }
                            ShortcutRow {
                                label: "Open in browser";
                                key-text: root.shortcut-open;
                                capturing: root.capturing-shortcut == "open";
                                edit => {
                                    root.capturing-shortcut = "open";
                                    root.shortcuts-status = "";
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }

                            Text {
                                text: "Reader and navigation";
                                color: Theme.text-muted;
                                font-size: 12px;
                                font-weight: 600;
                            }

                            VerticalLayout {
                                spacing: 5px;
                                HorizontalLayout { Text { text: "↑ / ↓"; width: 130px; color: Theme.accent; font-family: "monospace"; font-size: 12px; } Text { text: "Scroll reader"; color: Theme.text-muted; font-size: 12px; } }
                                HorizontalLayout { Text { text: "PageUp / PageDown"; width: 130px; color: Theme.accent; font-family: "monospace"; font-size: 12px; } Text { text: "Scroll by page"; color: Theme.text-muted; font-size: 12px; } }
                                HorizontalLayout { Text { text: "Space / Shift+Space"; width: 130px; color: Theme.accent; font-family: "monospace"; font-size: 12px; } Text { text: "Scroll by page"; color: Theme.text-muted; font-size: 12px; } }
                                HorizontalLayout { Text { text: "Space ×3"; width: 130px; color: Theme.accent; font-family: "monospace"; font-size: 12px; } Text { text: "Next article (compact reader)"; color: Theme.text-muted; font-size: 12px; } }
                                HorizontalLayout { Text { text: "Swipe ← / →"; width: 130px; color: Theme.accent; font-family: "monospace"; font-size: 12px; } Text { text: "Next / previous article (compact reader)"; color: Theme.text-muted; font-size: 12px; } }
                                HorizontalLayout { Text { text: "Home / End"; width: 130px; color: Theme.accent; font-family: "monospace"; font-size: 12px; } Text { text: "Reader start / end"; color: Theme.text-muted; font-size: 12px; } }
                                HorizontalLayout { Text { text: "Ctrl+O"; width: 130px; color: Theme.accent; font-family: "monospace"; font-size: 12px; } Text { text: "Open in browser"; color: Theme.text-muted; font-size: 12px; } }
                                HorizontalLayout { Text { text: "Esc"; width: 130px; color: Theme.accent; font-family: "monospace"; font-size: 12px; } Text { text: "Close dialog, drawer, or reader"; color: Theme.text-muted; font-size: 12px; } }
                                HorizontalLayout { Text { text: "?"; width: 130px; color: Theme.accent; font-family: "monospace"; font-size: 12px; } Text { text: "Show this help"; color: Theme.text-muted; font-size: 12px; } }
                            }
                        }
                    }

                    if root.shortcuts-status != "" : Text {
                        text: root.shortcuts-status;
                        color: Theme.danger;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;

                        Button {
                            text: "Reset defaults";
                            clicked => { root.reset-shortcuts(); }
                        }
                        Button {
                            text: "Close";
                            clicked => { root.close-shortcuts(); }
                        }
                    }
                }
            }
        }
    }
}
