import { Button, CheckBox, LineEdit, ListView, Palette, ScrollView } from "std-widgets.slint";

export struct FeedRow {
    id: string,
    title: string,
    folder: string,
    unread: int,
    icon: image,
}

export struct ArticleRow {
    id: string,
    title: string,
    feed: string,
    time: string,
    read: bool,
    starred: bool,
}

export struct ReaderBlock {
    kind: string,
    label: string,
    text: styled-text,
    indent: int,
    source: string,
    image: image,
    has-image: bool,
}

export global Theme {
    in property <bool> dark;
    out property <color> bg: dark ? #171715 : #f7f7f5;
    out property <color> surface: dark ? #1f1f1c : #ffffff;
    out property <color> surface-alt: dark ? #242420 : #fbfbf9;
    out property <color> block: dark ? #242420 : #f4f4f1;
    out property <color> text: dark ? #e8e8e2 : #242422;
    out property <color> text-muted: dark ? #a3a39a : #6b6b66;
    out property <color> text-faint: dark ? #7c7c74 : #999990;
    out property <color> border: dark ? #34342f : #e2e2de;
    out property <color> divider: dark ? #2b2b27 : #ecece8;
    out property <color> feed-selected: dark ? #2b3a4d : #e6edf7;
    out property <color> article-selected: dark ? #263141 : #eef3fa;
    out property <color> accent: dark ? #7ea6e0 : #4a6fa5;
    out property <color> settings-border: dark ? #3a3a34 : #d8d8d2;
    out property <color> danger: dark ? #e07a6f : #b03a2e;
    out property <color> warning: dark ? #d9b36a : #8a6d3b;
    out property <color> overlay: dark ? #00000099 : #00000066;
    out property <color> star: #c49a23;
}

component ReaderText inherits StyledText {
    in property <string> kind;
    default-font-size: kind == "h1" ? 26px
        : kind == "h2" ? 21px
        : kind == "h3" ? 18px
        : kind == "h4" || kind == "h5" || kind == "h6" ? 16px
        : kind == "code" ? 13px
        : kind == "table" ? 12px
        : kind == "image" ? 12px
        : 15px;
    default-color: kind == "quote" ? Theme.text-muted
        : kind == "image" ? Theme.text-muted
        : Theme.text;
    default-font-family: kind == "code" || kind == "table" ? "monospace" : "";
    horizontal-stretch: 1;
}

export component MainWindow inherits Window {
    title: "Nieuwser";
    preferred-width: 1280px;
    preferred-height: 820px;
    background: Theme.bg;

    in property <[FeedRow]> feeds;
    in property <[ArticleRow]> articles;
    in-out property <bool> dark-mode: false;

    init => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-mode => {
        Palette.color-scheme = self.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    in-out property <int> feed-index: 0;
    in-out property <int> article-index: -1;
    in property <string> reader-title;
    in property <string> reader-meta;
    in property <[ReaderBlock]> reader-blocks;
    in property <string> status;
    in property <string> last-synced;
    in property <bool> syncing: false;
    in-out property <bool> mark-read-on-open: true;
    in-out property <length> article-content-y: 0px;
    in-out property <string> search-query;

    in-out property <bool> settings-open;
    in-out property <string> settings-url;
    in-out property <string> settings-email;
    in-out property <string> settings-password;
    in property <string> settings-status;
    in-out property <bool> settings-busy;
    in property <bool> settings-has-account;

    callback refresh();
    callback open-settings();
    callback close-settings();
    callback save-settings(string, string, string);
    callback set-mark-read-on-open(bool);
    callback set-dark-mode(bool);
    callback next-article();
    callback prev-article();
    callback select-feed(int);
    callback select-article(int);
    callback search(string);
    callback open-link(string);
    callback toggle-read();
    callback toggle-star();
    callback mark-all-read();

    forward-focus: main-focus;

    main-focus := FocusScope {
        key-pressed(event) => {
            if (root.settings-open) {
                if (event.text == Key.Escape) {
                    root.close-settings();
                    accept
                } else {
                    reject
                }
            } else if (event.text == Key.DownArrow
                       || (event.text == "j" && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta)) {
                root.next-article();
                accept
            } else if (event.text == Key.UpArrow
                       || (event.text == "k" && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta)) {
                root.prev-article();
                accept
            } else if (event.text == "m" && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                root.toggle-read();
                accept
            } else if (event.text == "s" && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                root.toggle-star();
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
        Rectangle {
            height: 52px;
            background: Theme.surface;
            HorizontalLayout {
                padding: 12px;
                spacing: 12px;

                Text {
                    text: "Nieuwser";
                    font-size: 17px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 1px;
                    background: Theme.border;
                }

                Text {
                    text: root.status;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Text {
                    text: root.syncing ? "Syncing…" : "";
                    color: Theme.warning;
                    vertical-alignment: center;
                }

                Text {
                    text: root.last-synced;
                    color: Theme.text-faint;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                Button {
                    text: "Settings";
                    enabled: !root.syncing;
                    clicked => {
                        root.open-settings();
                    }
                }

                Button {
                    text: "Refresh";
                    enabled: !root.syncing;
                    clicked => {
                        root.refresh();
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            Rectangle {
                width: 260px;
                background: Theme.surface-alt;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "Feeds";
                        font-weight: 600;
                        color: Theme.text-muted;
                    }

                    ListView {
                        for feed[i] in root.feeds : Rectangle {
                            height: 38px;
                            border-radius: 6px;
                            background: i == root.feed-index ? Theme.feed-selected : transparent;

                            HorizontalLayout {
                                padding: 8px;
                                spacing: 6px;

                                Image {
                                    source: feed.icon;
                                    width: 16px;
                                    height: 16px;
                                    image-fit: contain;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: feed.title;
                                        overflow: elide;
                                        font-size: 13px;
                                    }
                                    Text {
                                        text: feed.folder;
                                        font-size: 10px;
                                        color: Theme.text-faint;
                                        overflow: elide;
                                    }
                                }

                                Text {
                                    text: feed.unread > 0 ? "(" + feed.unread + ")" : "";
                                    color: Theme.accent;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => {
                                    root.feed-index = i;
                                    root.select-feed(i);
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 1px;
                background: Theme.border;
            }

            Rectangle {
                width: 400px;
                background: Theme.surface;

                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Articles";
                            font-weight: 600;
                            color: Theme.text-muted;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "Mark all read";
                            clicked => {
                                root.mark-all-read();
                            }
                        }
                    }

                    LineEdit {
                        placeholder-text: "Search articles…";
                        text <=> root.search-query;
                        edited => {
                            root.search(root.search-query);
                        }
                    }

                    ListView {
                        content-y <=> root.article-content-y;
                        for article[i] in root.articles : Rectangle {
                            height: 64px;
                            border-radius: 6px;
                            background: i == root.article-index ? Theme.article-selected : transparent;

                            HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;

                                Text {
                                    text: article.read ? "" : "●";
                                    color: Theme.accent;
                                    font-size: 8px;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: article.title;
                                        font-size: 13px;
                                        font-weight: article.read ? 400 : 600;
                                        overflow: elide;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: article.feed;
                                            color: Theme.text-muted;
                                            font-size: 11px;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: article.time;
                                            color: Theme.text-faint;
                                            font-size: 11px;
                                        }
                                        Text {
                                            text: article.starred ? "★" : "";
                                            color: Theme.star;
                                            font-size: 11px;
                                        }
                                    }
                                }
                            }

                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => {
                                    root.article-index = i;
                                    root.select-article(i);
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 1px;
                background: Theme.border;
            }

            Rectangle {
                background: Theme.surface;

                VerticalLayout {
                    padding: 24px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Reader";
                            font-weight: 600;
                            color: Theme.text-muted;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "Mark read";
                            clicked => {
                                root.toggle-read();
                            }
                        }
                        Button {
                            text: "Star";
                            clicked => {
                                root.toggle-star();
                            }
                        }
                    }

                    ScrollView {
                        VerticalLayout {
                            spacing: 12px;

                            Text {
                                text: root.reader-title;
                                font-size: 24px;
                                font-weight: 700;
                                wrap: word-wrap;
                            }

                            Text {
                                text: root.reader-meta;
                                color: Theme.text-muted;
                                font-size: 12px;
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.divider;
                            }

                            for block in root.reader-blocks : VerticalLayout {
                                spacing: 4px;

                                if block.kind == "rule" : Rectangle {
                                    height: 1px;
                                    background: Theme.divider;
                                }

                                if block.kind == "image" : Rectangle {
                                    background: Theme.block;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;

                                        if block.has-image : Image {
                                            source: block.image;
                                            height: 320px;
                                            image-fit: contain;
                                        }

                                        Text {
                                            text: block.label;
                                            font-weight: 600;
                                            wrap: word-wrap;
                                        }
                                        if !block.has-image : ReaderText {
                                            text: block.text;
                                            kind: block.kind;
                                            link-clicked(link) => {
                                                root.open-link(link);
                                            }
                                        }
                                    }
                                }

                                if block.kind == "code" || block.kind == "table" : Rectangle {
                                    background: Theme.block;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 4px;
                                        if block.label != "" : Text {
                                            text: block.label;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.text-muted;
                                        }
                                        ReaderText {
                                            text: block.text;
                                            kind: block.kind;
                                        }
                                    }
                                }

                                if block.kind != "rule" && block.kind != "image" && block.kind != "code" && block.kind != "table" : HorizontalLayout {
                                    padding-left: block.indent * 18px;
                                    spacing: 8px;

                                    if block.kind == "quote" : Rectangle {
                                        width: 3px;
                                        background: Theme.border;
                                    }

                                    if block.label != "" : Text {
                                        text: block.label;
                                        width: 30px;
                                        color: Theme.text-muted;
                                        font-size: 14px;
                                        vertical-alignment: top;
                                    }

                                    ReaderText {
                                        text: block.text;
                                        kind: block.kind;
                                        link-clicked(link) => {
                                            root.open-link(link);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }

    if root.settings-open : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: Theme.overlay;

        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        Rectangle {
            width: 460px;
            height: 560px;
            x: (parent.width - 460px) / 2;
            y: (parent.height - 560px) / 2;
            background: Theme.surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.settings-border;

            VerticalLayout {
                padding: 24px;
                spacing: 8px;

                Text {
                    text: root.settings-has-account ? "FreshRSS account" : "Connect to FreshRSS";
                    font-size: 22px;
                    font-weight: 700;
                }

                Text {
                    text: "Enter your server URL and API password. The password is exchanged for a token and is not saved.";
                    color: Theme.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                CheckBox {
                    text: "Mark articles read when opened";
                    checked <=> root.mark-read-on-open;
                    toggled => {
                        root.set-mark-read-on-open(self.checked);
                    }
                }

                CheckBox {
                    text: "Dark theme";
                    checked <=> root.dark-mode;
                    toggled => {
                        root.set-dark-mode(self.checked);
                    }
                }

                Text {
                    text: "Server URL";
                    color: Theme.text-muted;
                    font-size: 12px;
                    font-weight: 600;
                }
                LineEdit {
                    text <=> root.settings-url;
                    placeholder-text: "https://freshrss.example.net/api/";
                }

                Text {
                    text: "Username or email";
                    color: Theme.text-muted;
                    font-size: 12px;
                    font-weight: 600;
                }
                LineEdit {
                    text <=> root.settings-email;
                    placeholder-text: "admin";
                }

                Text {
                    text: "API password";
                    color: Theme.text-muted;
                    font-size: 12px;
                    font-weight: 600;
                }
                LineEdit {
                    text <=> root.settings-password;
                    input-type: password;
                }

                Text {
                    text: root.settings-status;
                    color: Theme.danger;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    if root.settings-has-account : Button {
                        text: "Cancel";
                        enabled: !root.settings-busy;
                        clicked => {
                            root.close-settings();
                        }
                    }

                    Button {
                        text: root.settings-busy ? "Connecting…" : "Save & sync";
                        enabled: !root.settings-busy;
                        clicked => {
                            root.save-settings(root.settings-url, root.settings-email, root.settings-password);
                        }
                    }
                }
            }
        }
    }
}
